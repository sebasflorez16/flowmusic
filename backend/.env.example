# Variables de entorno para el backend. Copia este archivo a `.env` y completa
# los valores. NUNCA subas `.env` a git (está en .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgres://musicflow:musicflow@localhost:5432/musicflow

# --- Redis (Celery + Channels) ---
REDIS_URL=redis://localhost:6379/0

# --- Wompi (pagos) ---
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pk_test_xxx
WOMPI_PRIVATE_KEY=pr_test_xxx
WOMPI_EVENTS_SECRET_KEY=events_secret_xxx
WOMPI_INTEGRITY_KEY=integrity_xxx

# --- Alertas por WhatsApp (Twilio) ---
# Mientras estén vacíos, no se envían alertas (el resto funciona normal).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número emisor de WhatsApp Business (ej. whatsapp:+573202074066)
TWILIO_FROM_WHATSAPP=whatsapp:+573202074066
# Destinatarios (E.164 sin "+"): facturación a todos, bar nuevo solo el primero.
BILLING_ALERT_RECIPIENTS=573223088873,573132862002
NEW_BAR_ALERT_RECIPIENTS=573223088873
BILLING_ALERT_DAYS_BEFORE=2

# --- Almacenamiento S3 / Cloudflare R2 (producción) ---
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Email (SendGrid / Resend) ---
SENDGRID_API_KEY=
# RESEND_API_KEY=

# --- CORS (frontends separados) ---
# En producción, lista de orígenes permitidos separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Sentry (producción) ---
SENTRY_DSN=
